// RadialBlur — nuke-agent example (original code).
// category: 2D gather | teaches: eAccessRandom, sampling arbitrary coordinates
// verified: live-compiled in Nuke 17.0v3 (nuke-mcp)
kernel RadialBlurKernel : public ImageComputationKernel<ePixelWise>
{
  Image<eRead, eAccessRandom, eEdgeClamped> src;
  Image<eWrite, eAccessPoint> dst;

param:
  float amount;
  int samples;

local:
  float2 center;

  void define() {
    defineParam(amount, "Amount", 0.2f);
    defineParam(samples, "Samples", 8);
  }

  void init() {
    center = float2(src.bounds.width() / 2.0f, src.bounds.height() / 2.0f);
  }

  void process(int2 pos) {
    float4 sum = float4(0.0f);
    float2 here = float2(pos.x, pos.y);
    for (int i = 0; i < samples; ++i) {
      float t = amount * float(i) / float(samples);
      float2 p = here * (1.0f - t) + center * t;
      sum += src(int(p.x), int(p.y));
    }
    dst() = sum / float(samples);
  }
};
