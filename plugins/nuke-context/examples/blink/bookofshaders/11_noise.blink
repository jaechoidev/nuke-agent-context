// 11_noise — nuke-agent example (original code).
// category: bookofshaders/generative | teaches: value noise = smooth-interpolated random
// port of the technique in The Book of Shaders ch.11 (original Blink; not their code).
// verified: live-rendered in Nuke 17.0v3
kernel BoSNoise : public ImageComputationKernel<ePixelWise>
{
  Image<eRead, eAccessPoint> src;
  Image<eWrite, eAccessPoint> dst;
local:
  float2 res;

  float fract(float x) { return x - floor(x); }

  float rand(float2 st) {
    return fract(sin(dot(st, float2(12.9898f, 78.233f))) * 43758.5453f);
  }

  float noise(float2 st) {
    float2 i = floor(st);
    float2 f = st - i;
    float a = rand(i);
    float b = rand(i + float2(1.0f, 0.0f));
    float c = rand(i + float2(0.0f, 1.0f));
    float d = rand(i + float2(1.0f, 1.0f));
    float2 u = f * f * (float2(3.0f, 3.0f) - 2.0f * f);   // hermite, replaces smoothstep
    return lerp(a, b, u.x) + (c - a) * u.y * (1.0f - u.x) + (d - b) * u.x * u.y;
  }

  void init() { res = float2(float(dst.bounds.width()), float(dst.bounds.height())); }

  void process(int2 pos) {
    float2 st = float2(float(pos.x), float(pos.y)) / res * 5.0f;
    float n = noise(st);
    dst() = float4(n, n, n, 1.0f);
  }
};
